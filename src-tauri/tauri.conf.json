{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vasya",
  "version": "0.4.0",
  "identifier": "local.vasya.assistant",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Вася",
        "width": 1080,
        "height": 800,
        "minWidth": 760,
        "minHeight": 600
      },
      {
        "label": "island",
        "url": "index.html?overlay=1",
        "title": "Вася · голосовой помощник",
        "width": 440,
        "height": 124,
        "visible": false,
        "focus": false,
        "focusable": false,
        "transparent": true,
        "backgroundColor": "#00000000",
        "decorations": false,
        "shadow": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Russian",
          "English"
        ],
        "displayLanguageSelector": true
      },
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      }
    },
    "resources": {
      "resources/speech/": "speech/",
      "../THIRD_PARTY.md": "THIRD_PARTY.md",
      "../licenses/": "licenses/"
    }
  }
}
