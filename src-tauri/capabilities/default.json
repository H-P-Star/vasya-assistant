{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Only the local settings window may call assistant commands",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "allow-get-state",
    "allow-list-microphones",
    "allow-test-microphone",
    "allow-finish-setup",
    "allow-check-llm",
    "allow-set-muted",
    "allow-activate",
    "allow-run-text",
    "allow-open-music-login",
    "allow-insert-result",
    "allow-save-settings"
  ]
}
